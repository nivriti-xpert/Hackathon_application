<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SOS</title>
<style>
*{box-sizing:border-box}
body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f8fafc;font-family:Inter,system-ui,sans-serif;color:#1e293b;padding:16px}
.box{width:100%;max-width:380px;background:#fff;border:1px solid #e2e8f0;border-radius:24px;padding:28px 24px;text-align:center}
h2{font-size:30px;margin:0 0 8px;font-weight:800}
p{font-size:14px;color:#64748b;margin:0 0 24px}
#sos{width:200px;height:200px;border-radius:50%;background:#e11d48;color:#fff;border:0;display:inline-flex;align-items:center;justify-content:center;font:800 64px inherit;font-family:inherit;letter-spacing:2px;cursor:pointer;box-shadow:0 10px 24px rgba(225,29,72,.3)}
#sos:hover{background:#be123c}
#sos:active{transform:scale(.96)}
#done{display:none;background:#fff1f2;border:1px solid #fecdd3;border-radius:12px;padding:14px;font-size:15px;color:#9f1239;font-weight:600}
#done span{display:block;font-weight:400;font-size:12px;color:#be123c;margin-top:4px}
#undo{background:none;border:0;color:#64748b;font-size:12px;text-decoration:underline;cursor:pointer;margin-top:12px}
#help{margin-top:22px;width:100%;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:12px;padding:11px;font:600 14px inherit;font-family:inherit;color:#334155;cursor:pointer}
#help:hover{background:#e2e8f0}
#steps{display:none;text-align:left;font-size:13px;color:#475569;margin-top:12px;padding:12px 12px 12px 30px;background:#f8fafc;border-radius:12px;line-height:1.6}
#steps li{margin-bottom:4px}

</style>

</head>
<body>
<div class="box">
<h2>Emergency SOS</h2>
<p>Tap the button to alert the nearest police station.</p>
<button id="sos">SOS</button>
<div id="done">
Nearest police station has been informed.
<span>Your location has been shared.</span>
<button id="undo">Sent by mistake? Cancel</button>
</div>
</div>
<script>
var sos=document.getElementById('sos')
var done=document.getElementById('done')
var steps=document.getElementById('steps')
sos.onclick=function(){
  sos.style.display='none'
  done.style.display='block'
}
document.getElementById('undo').onclick=function(){
  done.style.display='none'
  sos.style.display='inline-flex'
}
document.getElementById('help').onclick=function(){
  steps.style.display=steps.style.display==='block'?'none':'block'
}
</script>



</body>
</html>
